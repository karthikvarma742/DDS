#include <iostream>
using namespace std;
#define size 6
int stack [size];
int top = -1;
 void push (int num){
    if(top<size-1){
        top++;
        stack[top] = num;
        cout<<num<<"inserted sucessfully"<<endl;
    }
    else{
        cout<<"stack is overflow";
    }
}

int main(){
    push(5);
    push(6);
    push(10);
    push(1);
    push(11);
    push(4);
    push(9);
    push(2);
    
    
}
